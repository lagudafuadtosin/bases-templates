filters:
  and:
    - file.inFolder("Books")
views:
  - type: table
    name: All books
    order:
      - file.name
      - status
      - author
  - type: table
    name: To read
    filters:
      and:
        - status == "to read"
    order:
      - file.name
      - author
  - type: table
    name: Finished
    filters:
      and:
        - status == "finished"
    order:
      - file.name
      - author
